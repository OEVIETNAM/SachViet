---
import { getCollection } from 'astro:content';
import LayoutChinh from '../../layouts/LayoutChinh.astro';
import TheSach from '../../components/TheSach.astro';

export async function getStaticPaths({ paginate }) {
  const goc = import.meta.env.BASE_URL;
  const tat_ca_sach = await getCollection('sach');
  const tat_ca_chuong = await getCollection('chuong');

  function duong_dan_doc_dau_tien(ma_sach: string): string {
    const cac_chuong_cua_sach = tat_ca_chuong
      .filter((c) => c.id.startsWith(`${ma_sach}/`))
      .sort((a, b) => a.data.thu_tu - b.data.thu_tu);
    const chuong_dau = cac_chuong_cua_sach[0];
    return chuong_dau ? `${goc}doc/${chuong_dau.id}/` : '#';
  }

  // Sắp theo tên A-Z cho dễ dò tìm khi duyệt nhiều trang
  const sach_kem_link = tat_ca_sach
    .map((sach) => ({ sach, duong_dan_doc: duong_dan_doc_dau_tien(sach.id) }))
    .sort((a, b) => a.sach.data.tieu_de.localeCompare(b.sach.data.tieu_de, 'vi'));

  return paginate(sach_kem_link, { pageSize: 30 });
}

const { page } = Astro.props;
const goc = import.meta.env.BASE_URL;

// page.url.prev / page.url.next đã có sẵn base do Astro tự xử lý theo "base" trong config
---

<LayoutChinh tieu_de={`Tất cả sách — trang ${page.currentPage}`} mo_ta="Duyệt toàn bộ sách trong thư viện, xếp theo tên A-Z.">
  <div class="khung-trang trang-tat-ca">
    <header class="dau-trang-tat-ca">
      <h1>📚 Tất cả sách</h1>
      <p>{page.total} cuốn — trang {page.currentPage} / {page.lastPage}</p>
    </header>

    <div class="luoi-sach">
      {
        page.data.map(({ sach, duong_dan_doc }) => (
          <TheSach
            duong_dan_doc={duong_dan_doc}
            tieu_de={sach.data.tieu_de}
            tac_gia={sach.data.tac_gia}
            mo_ta={sach.data.mo_ta}
            bia={sach.data.bia}
            nhom_tuoi={sach.data.nhom_tuoi}
          />
        ))
      }
    </div>

    <nav class="dieu-huong-trang" aria-label="Điều hướng phân trang">
      {
        page.url.prev ? (
          <a href={page.url.prev} class="nut-trang">← Trang trước</a>
        ) : (
          <span class="nut-trang nut-trang-vo-hieu">← Trang trước</span>
        )
      }
      <span class="so-trang">Trang {page.currentPage} / {page.lastPage}</span>
      {
        page.url.next ? (
          <a href={page.url.next} class="nut-trang">Trang sau →</a>
        ) : (
          <span class="nut-trang nut-trang-vo-hieu">Trang sau →</span>
        )
      }
    </nav>
  </div>

  <style>
    .trang-tat-ca {
      padding-block: 32px 64px;
    }
    .dau-trang-tat-ca {
      text-align: center;
      margin-bottom: 32px;
    }
    .dau-trang-tat-ca h1 {
      color: var(--do-chinh);
      font-size: 2rem;
    }
    .dau-trang-tat-ca p {
      color: var(--chu-nhat);
      margin-top: 6px;
    }
    .luoi-sach {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 28px 20px;
      justify-items: center;
    }
    .luoi-sach > :global(a) {
      width: 100%;
      max-width: 190px;
    }
    .dieu-huong-trang {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin-top: 56px;
      padding-top: 24px;
      border-top: 3px solid var(--chu-dam);
    }
    .nut-trang {
      font-family: var(--font-tieu-de);
      font-weight: 700;
      padding: 10px 20px;
      background: var(--do-chinh);
      color: var(--trang);
      border-radius: 999px;
      transition: transform 0.15s ease;
    }
    .nut-trang:hover {
      transform: translateY(-2px);
    }
    .nut-trang-vo-hieu {
      background: var(--nen-kem-dam);
      color: var(--chu-nhat);
      cursor: default;
    }
    .so-trang {
      font-family: var(--font-tieu-de);
      color: var(--chu-nhat);
      font-weight: 600;
    }
  </style>
</LayoutChinh>
