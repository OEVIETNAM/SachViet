---
import '../styles/toan-cuc.css';

interface Props {
  tieu_de: string;
  mo_ta?: string;
}

const { tieu_de, mo_ta = 'Thư viện sách tiếng Việt cho mọi lứa tuổi.' } = Astro.props;
const goc = import.meta.env.BASE_URL; // vd: "/SachViet/" khi deploy lên GitHub Pages
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={mo_ta} />
    <title>{tieu_de} · Sách Việt</title>

    <link rel="icon" href={`${goc}favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${goc}favicon-16.png`} type="image/png" sizes="16x16" />
    <link rel="icon" href={`${goc}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${goc}apple-touch-icon.png`} />
    <link rel="manifest" href={`${goc}manifest.json`} />
    <link rel="alternate" type="application/rss+xml" title="Sách Việt — sách mới đăng" href={`${goc}rss.xml`} />
    <meta name="theme-color" content="#d6293c" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="dau-trang">
      <div class="khung-trang thanh-dieu-huong">
        <a href={goc} class="logo">
          <img src={`${goc}favicon-32.png`} alt="" width="32" height="32" />
          <span>Sách Việt</span>
        </a>
        <div class="ben-phai">
          <span class="dong-ho" id="dong-ho-ngay-gio" aria-live="off">
            <span class="dong-ho-day-du"></span>
            <span class="dong-ho-gon"></span>
          </span>
          <nav>
            <a href={`${goc}tat-ca/`}>Tất cả sách</a>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="chan-trang">
      <div class="khung-trang">
        <p>Sách Việt — thư viện truyện dịch tiếng Việt, làm bằng ❤️ cho mọi lứa tuổi.</p>
      </div>
    </footer>

    <style>
      .dau-trang {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--nen-kem);
      }
      .thanh-dieu-huong {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 14px;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-tieu-de);
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--do-chinh);
      }
      .ben-phai {
        display: flex;
        align-items: center;
        gap: 18px;
      }
      .dong-ho {
        font-family: var(--font-tieu-de);
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--chu-dam);
        white-space: nowrap;
      }
      .dong-ho-gon {
        display: none;
      }
      @media (max-width: 640px) {
        .dong-ho-day-du {
          display: none;
        }
        .dong-ho-gon {
          display: inline;
        }
        .ben-phai {
          gap: 10px;
        }
        .logo span {
          display: none;
        }
      }
        font-family: var(--font-tieu-de);
        font-weight: 600;
        padding: 8px 18px;
        background: var(--do-chinh);
        color: var(--trang);
        border-radius: 999px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .thanh-dieu-huong nav a:hover {
        transform: translateY(-2px);
        box-shadow: var(--do-bong-hover);
      }
      .chan-trang {
        margin-top: 80px;
        padding-block: 28px;
        text-align: center;
        color: var(--chu-nhat);
        font-size: 0.9rem;
      }
    </style>

    <script>
      // Đồng hồ ngày giờ theo múi giờ Việt Nam, tự cập nhật mỗi phút
      const TEN_THU_THEO_TIENG_ANH: Record<string, string> = {
        Sunday: 'Chủ Nhật',
        Monday: 'Thứ 2',
        Tuesday: 'Thứ 3',
        Wednesday: 'Thứ 4',
        Thursday: 'Thứ 5',
        Friday: 'Thứ 6',
        Saturday: 'Thứ 7',
      };

      function layBuoiTrongNgay(gio: number): string {
        if (gio < 5) return 'Đêm';
        if (gio < 11) return 'Sáng';
        if (gio < 13) return 'Trưa';
        if (gio < 18) return 'Chiều';
        return 'Tối';
      }

      function capNhatDongHo() {
        const bay_gio = new Date();

        const dinh_dang_so = new Intl.DateTimeFormat('en-US', {
          timeZone: 'Asia/Ho_Chi_Minh',
          hourCycle: 'h23',
          hour: 'numeric',
          minute: '2-digit',
          day: 'numeric',
          month: 'numeric',
          year: 'numeric',
        });
        const cac_phan = Object.fromEntries(dinh_dang_so.formatToParts(bay_gio).map((p) => [p.type, p.value]));

        const dinh_dang_thu = new Intl.DateTimeFormat('en-US', {
          timeZone: 'Asia/Ho_Chi_Minh',
          weekday: 'long',
        });
        const ten_thu = TEN_THU_THEO_TIENG_ANH[dinh_dang_thu.format(bay_gio)] ?? '';

        const gio = Number(cac_phan.hour);
        const phut = cac_phan.minute;
        const ngay = cac_phan.day;
        const thang = cac_phan.month;
        const nam = cac_phan.year;
        const buoi = layBuoiTrongNgay(gio);

        const chuoi_day_du = `${buoi} ${gio}:${phut} ${ten_thu} ngày ${ngay}/${thang}/${nam}`;
        const chuoi_gon = `${gio}:${phut} ${ngay}/${thang}`;

        const the_day_du = document.querySelector('.dong-ho-day-du');
        const the_gon = document.querySelector('.dong-ho-gon');
        if (the_day_du) the_day_du.textContent = chuoi_day_du;
        if (the_gon) the_gon.textContent = chuoi_gon;
      }

      capNhatDongHo();
      setInterval(capNhatDongHo, 30_000);
    </script>
  </body>
</html>
